# Local fallback: run python tools/setup_demo.py to generate private values.
AUTH_MODE=demo
DATABASE_URL=sqlite:///./bizflow.db
SESSION_SECRET=
DEMO_PASSWORD=
ALLOW_DEMO_RESET=true
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_BYTES=5242880

# Production Supabase: AUTH_MODE=supabase; database URL uses the psycopg dialect.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
SUPABASE_URL=
# Only the Supabase project URL and publishable/anon key may enter VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Empty means same origin (/api is proxied by Vite locally and nginx in Docker).
VITE_API_BASE_URL=

# Optional delegated OneDrive. Never use VITE_* for these values.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/auth/microsoft/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
