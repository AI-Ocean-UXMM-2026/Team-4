# Supabase is the sole authentication provider. No demo-password access exists.
DATABASE_URL=sqlite:///./bizflow.db
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# App password rules; configure Supabase with the same or stronger rules.
AUTH_PASSWORD_MIN_LENGTH=8
# Comma-separated character classes required for signup and password reset.
AUTH_PASSWORD_REQUIRED_CHARACTERS=lower,upper,number,symbol

# Trusted app origin only, no arbitrary redirects or wildcard production redirect URLs.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
VITE_API_BASE_URL=
MAX_UPLOAD_BYTES=5242880

# Production PostgreSQL (server only):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Optional approved school OneDrive integration (server only).
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/v1/auth/microsoft/callback
TOKEN_ENCRYPTION_KEY=

# AI provider settings are server-only. Keep the key out of VITE_* variables.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# For OpenRouter, set AI_PROVIDER=openrouter and use an OpenRouter key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5-mini
# Optional: label one known local import as synthetic for a demo.
AI_SYNTHETIC_DEMO_BUSINESS_ID=
AI_SYNTHETIC_DEMO_IMPORT_SHA256=
