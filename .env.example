# Supabase is the sole authentication provider. No demo-password access exists.
DATABASE_URL=sqlite:///./bizflow.db
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# These mirror the password rules configured in Supabase Auth; provider remains authoritative.
AUTH_PASSWORD_MIN_LENGTH=8
# Comma-separated: lower,upper,number,symbol. Leave blank if no character-class rule.
AUTH_PASSWORD_REQUIRED_CHARACTERS=

# Trusted app origin only, no arbitrary redirects or wildcard production redirect URLs.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
VITE_API_BASE_URL=
MAX_UPLOAD_BYTES=5242880

# Production PostgreSQL (server only):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Optional approved school OneDrive integration (server only).
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/v1/auth/microsoft/callback
TOKEN_ENCRYPTION_KEY=
